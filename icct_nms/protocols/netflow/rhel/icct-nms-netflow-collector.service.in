[Unit]
Description=ICCT NMS NetFlow / IPFIX UDP Collector Daemon
After=network.target mariadb.service

[Service]
Type=simple
User=@@WEB_USER@@
Group=@@WEB_GROUP@@
ExecStart=/usr/bin/php @@CACTI_ROOT@@/plugins/icct_nms/protocols/netflow/cli/netflow_worker.php --daemon --port=2055
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

