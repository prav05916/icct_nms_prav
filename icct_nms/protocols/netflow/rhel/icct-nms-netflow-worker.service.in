[Unit]
Description=ICCT NMS NetFlow periodic sync worker
After=network.target mariadb.service
PartOf=icct-nms-netflow-worker.timer

[Service]
Type=oneshot
User=@@WEB_USER@@
Group=@@WEB_GROUP@@
ExecStart=/usr/bin/php @@CACTI_ROOT@@/plugins/icct_nms/protocols/netflow/cli/netflow_worker.php --sync --limit=500
StandardOutput=journal
StandardError=journal
TimeoutSec=45

